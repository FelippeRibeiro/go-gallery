PORT=8080

DB_URL=postgres://postgres:go-gallery@localhost:5432/gallery?sslmode=disable

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=xGGXvbprQad++HqXR3pGYhPddsF+pOr0wQep06TghnU=
S3_PUBLIC_ENDPOINT=http://localhost:9000

JWT_SECRET=change-me-in-production

# Atributo Secure do cookie de autenticação. Use true em produção (HTTPS);
# deixe vazio/false em dev sob http://localhost.
COOKIE_SECURE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-app
SMTP_FROM=noreply@go-gallery.com


# Backend público (para a notification_url do webhook do Mercado Pago).
# Em produção, use o domínio público acessível externamente.
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

# Mercado Pago. Token privado da conta — deixe vazio para desabilitar o gateway
# (o pedido é criado sem redirecionamento de pagamento).
MP_ACCESS_TOKEN=

# MP_SANDBOX=true usa o ambiente de teste (sandbox_init_point no Checkout Pro).
# Necessário porque as credenciais de teste novas do MP também usam o prefixo
# APP_USR-, indistinguíveis das de produção pelo token. Use com credenciais e
# usuários de teste. Em produção, deixe vazio/false.
MP_SANDBOX=true

# Chave secreta do webhook (painel do MP > Webhooks > assinatura secreta).
# Opcional: se definida, o endpoint /api/webhooks/mercadopago valida o header
# x-signature e descarta notificações forjadas. Vazio = sem validação.
MP_WEBHOOK_SECRET=
